{
  // Build-tooling config files. These run in Node, not the browser, so they get Node
  // globals (__dirname, process, node: builtins) instead of the app project's DOM libs.
  // Checked by `npm run typecheck`, not via a tsconfig.json "references" entry: a
  // referenced project requires "composite", which is incompatible with "noEmit".
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true
  },
  "include": ["vite.config.ts", "playwright.config.ts", "orval.config.ts"]
}
